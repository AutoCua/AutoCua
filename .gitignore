# User data — lives OUTSIDE the install folder so an uninstall can't destroy it
# (the installer's [UninstallDelete] wipes all of {app}). `python main.py` puts
# it at the repo root; the packaged build uses <home>/AutoCua_data. The default
# skills are tracked inside the package (AutoCua/default_skills/), so nothing
# under here is tracked except vault/README.md (the credentials.json format).
/AutoCua_data/*
!/AutoCua_data/vault/
/AutoCua_data/vault/*
!/AutoCua_data/vault/README.md

# LEGACY chat location (pre-AutoCua_data) — kept ignored until every checkout has
# migrated, so a contributor who pulls this change before launching the app can't
# commit real chat transcripts still sitting in the package folder.
/AutoCua/agent_conversation/index.json
/AutoCua/agent_conversation/chat_*/
automation_grant.json
AutoCua/ios_connector/paired_devices.json
/AutoCua/web/target
/AutoCua/mac/scratchpad
/AutoCua/linux/scratchpad
/AutoCua/windows/scratchpad
/AutoCua/web/scratchpad
/AutoCua/ios/scratchpad
/AutoCua/ios_connector/WebDriverAgent
# Staging tree for the runtime clone (utils/wda.py); only outlives a crash.
/AutoCua/ios_connector/.WebDriverAgent.incoming.*

# Local-only tooling (never pushed)
/sync.py

# Interception SDK — the kernel-level input driver used for UAC interaction.
# Third-party vendored download (installer, library, samples), not our source;
# it lands here per-machine and has no business in the repo.
/Interception/

# The Chromium desktop shell's npm install (desktop/package-lock.json is kept)
/desktop/node_modules/
