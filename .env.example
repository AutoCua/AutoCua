# AutoCua API keys
#
# Copy this file to .env, then fill in a key for at least one provider:
#   macOS / Linux:  cp .env.example .env
#   Windows:        copy .env.example .env
#
# .env is gitignored, so your keys stay on your machine - never commit them.
# A key entered in the app's Settings takes priority over the same key here.

# --- Model providers (one is enough) ---
ANTHROPIC_API_KEY=
CEREBRAS_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
PERPLEXITY_API_KEY=
TOGETHER_API_KEY=

# --- AWS Bedrock ---
# A Bedrock API key (sent as a Bearer token), not an IAM access key pair.
AWS_API_KEY=
# Bedrock region. Leave commented out to use the default, eu-west-2.
# AWS_BEDROCK_REGION=eu-west-2

# --- Google Vertex AI ---
# Uncomment only if you use Vertex models. Values in Settings win over these.
# VERTEX_PROJECT_ID=your-gcp-project-id
# VERTEX_LOCATION=global

# --- Telegram remote control ---
# The bot token is NOT read from this file. Paste TELEGRAM_BOT_TOKEN into the
# app's Settings instead.
